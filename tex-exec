#!/bin/sh
# tex-exec IMAGE PAPER_ROOT TOOL [ARGS...]: run a TeX tool in the TeX Live image, at the same paths
# as on the host (live.py sets LATEX_LIVE_EXEC to this). The image is checked on every call (~30 ms):
# while it is missing, the host's TeX runs instead, and the image is used again once it is pulled.
#
# Rootless podman maps container root to the caller, so outputs stay owned by us. latexmk passes
# BIBINPUTS/BSTINPUTS/TEXINPUTS through the environment when it runs bibtex from build/; forward
# them (unset ones are skipped), plus max_print_line (unwrapped log lines, for latex_report.py).
#
# In shared mode, where coauthors write the sources, live.py sets LATEX_LIVE_REQUIRE_IMAGE=1: never
# the host's TeX, so a missing image fails the run; and LATEX_LIVE_SANDBOX=1: the paper folder is
# mounted read-only and only its build folder ($LATEX_LIVE_BUILD) writable; the container gets no
# capabilities, no new privileges, at most 512 processes, 4 GB of memory, 2 CPUs, files of at most
# 1 GB and the caller's deadline ($LATEX_LIVE_TIMEOUT seconds, at most 10 minutes: podman stops it
# then, even when the caller has stopped waiting); it is labelled with the instance
# ($LATEX_LIVE_INSTANCE), the run ($LATEX_LIVE_RUN, e.g. main-12) and its kind (main), so that live.py
# can stop it; and TeX gets no shell escape, and no files outside its working directory and the TeX
# tree (openin_any=p). The paper's dot entries, at any depth (.git, whose config may hold a remote's
# credentials, .env, chapters/.private/, ...), are hidden (podman's mask: they read as empty, and one
# deleted meanwhile is skipped rather than made again in the paper), since biber and latexdiff
# ignore openin_any. A dot entry that is a symbolic link is left: in the
# container, where the paper is the only folder mounted, it leads into the paper, which shows nothing
# hidden, or into the image. A name with a newline, ':' or ',' can't be hidden this way, so the run
# is refused.
# That skips the image's entrypoint, which switches users and so needs a capability.
#
# A warm standby of the live build (latexlive/standby.py) sets LATEX_LIVE_STANDBY_LABEL: its container gets
# that label, its run's (LATEX_LIVE_RUN) and a deadline (LATEX_LIVE_TIMEOUT seconds, at most 2 hours), so that
# it stops even if nothing stops it, and it never runs on the host's TeX, which a normal pass would not use
# once the image is back.
image=$1 root=$2
shift 2
if podman image exists "$image"; then
    if [ "$LATEX_LIVE_SANDBOX" = 1 ]; then
        build="$root/${LATEX_LIVE_BUILD:-build}"
        set -- "$image" "$@"
        nl='
'
        run=${LATEX_LIVE_RUN:-other} kind=${LATEX_LIVE_RUN:-other}
        kind=${kind%%-*}
        timeout=${LATEX_LIVE_TIMEOUT:-600}
        case $timeout in ''|*[!0-9]*) timeout=600 ;; esac
        if [ "$timeout" -gt 600 ] || [ "$timeout" -lt 1 ]; then timeout=600; fi
        dots=$(find "$root" -path "$build" -prune -o ! -path "$root" -name '.*' -prune ! -type l -print) || dots=-
        if [ -n "$(find "$root" -path "$build" -prune -o -name "*$nl*" -print | head -c 1)" ]; then dots=-; fi
        case $dots in
            -|*:*|*,*)
                echo "=== latex-live: the paper has a dot entry that can't be hidden (or find failed); not running $2" >&2
                exit 1 ;;
        esac
        if [ "$(printf '%s\n' "$dots" | wc -l)" -gt 1000 ]; then
            echo "=== latex-live: the paper has more than 1000 dot entries to hide; not running $2" >&2
            exit 1
        fi
        set -f
        saved=$IFS IFS=$nl mask=
        for entry in $dots; do
            case $entry in "$root"/*) ;; *) echo "=== latex-live: a dot entry can't be hidden; not running $2" >&2; exit 1 ;; esac
            mask=${mask:+$mask:}$entry
        done
        IFS=$saved
        set +f
        if [ -n "$mask" ]; then set -- --security-opt "mask=$mask" "$@"; fi
        set -- --cap-drop=all --security-opt=no-new-privileges --pids-limit=512 --memory=4g --cpus=2 \
            --ulimit fsize=1073741824:1073741824 --timeout="$timeout" --entrypoint= \
            --label "latex-live.instance=$LATEX_LIVE_INSTANCE" --label "latex-live.run=$run" \
            --label "latex-live.kind=$kind" \
            -v "$root:$root:ro" -v "$build:$build" -e openin_any=p -e openout_any=p -e shell_escape=f "$@"
    else
        set -- -v "$root:$root" "$image" "$@"
        if [ -n "$LATEX_LIVE_STANDBY_LABEL" ]; then
            timeout=${LATEX_LIVE_TIMEOUT:-3600}
            case $timeout in ''|*[!0-9]*) timeout=3600 ;; esac
            if [ "$timeout" -gt 7200 ] || [ "$timeout" -lt 1 ]; then timeout=3600; fi
            set -- --timeout="$timeout" --label "latex-live.standby=$LATEX_LIVE_STANDBY_LABEL" \
                --label "latex-live.run=${LATEX_LIVE_RUN:-standby}" "$@"
        fi
    fi
    exec podman run --rm --init --pull=never --network=none --security-opt label=disable \
        -w "$(pwd -P)" -e BIBINPUTS -e BSTINPUTS -e TEXINPUTS -e max_print_line "$@"
fi
if [ "$LATEX_LIVE_REQUIRE_IMAGE" = 1 ] || [ -n "$LATEX_LIVE_STANDBY_LABEL" ]; then
    who="shared mode"; if [ -n "$LATEX_LIVE_STANDBY_LABEL" ]; then who="a warm standby"; fi
    echo "=== latex-live: $image is not pulled (to fix: podman pull $image); $who never runs the host's $1" >&2
    exit 1
fi
echo "=== latex-live: $image is not pulled (to fix: podman pull $image); using the host's $1" >&2
exec "$@"
